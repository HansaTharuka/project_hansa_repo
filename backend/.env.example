# WealthWise backend environment (deployment.md §5.1).
# Copy this file to backend/.env and replace every placeholder with a local value.
# backend/.env is git-ignored and must never be committed.

# SQLite database file, relative to backend/.
DATABASE_URL=sqlite:///./wealthwise.db

# Signing key for access tokens. Generate locally with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Access-token lifetime in whole minutes.
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=60

# Whole-percent drift threshold seeding RebalancingThreshold version 1 (BRD §5.1).
DEFAULT_DRIFT_THRESHOLD_PERCENT=5

# Directory holding asset_classes.csv and nav_initial.csv, relative to backend/.
SEED_CSV_PATH=seed

# Root log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
